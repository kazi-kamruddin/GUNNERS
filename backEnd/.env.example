# Environment
ENVIRONMENT=development
DEBUG=True

# Server
PORT=8000
HOST=127.0.0.1

# Database (Local SQLite for development/testing, Supabase PostgreSQL for staging/production)
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Football Data Provider (Register free key at https://www.football-data.org/)
# Leave empty to test with mock/fallback mode
FOOTBALL_DATA_API_KEY=

# Supabase Credentials (for Auth & Database)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
