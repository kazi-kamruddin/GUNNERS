# Environment
ENVIRONMENT=development
DEBUG=True
TESTING=False

# Server
PORT=8000
HOST=127.0.0.1

# CORS (comma-separated or JSON array)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Database
# Local SQLite for development/testing, or Supabase PostgreSQL via PgBouncer (:6543)
# e.g. postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Football Data Provider (Register free key at https://www.football-data.org/)
# Leave empty to test with mock/fallback mode
FOOTBALL_DATA_API_KEY=

# Supabase Auth Credentials (fill from Supabase Project Settings -> API)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
